# .env.example — ai-failure-forensics
# Copy to .env and fill in values to activate live backends. Leave blank for mock mode.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROGRESSIVE CREDENTIAL LOADING (PCL)                                   │
# │  No keys needed to run. Add keys to unlock production-grade backends.   │
# └─────────────────────────────────────────────────────────────────────────┘

# ── AI Providers ─────────────────────────────────────────────────────────
# UNSET (default): Deterministic mock response (zero network calls, CI-safe)
# SET to OpenAI key (sk-...): Live GPT-4o-mini evaluation
OPENAI_API_KEY=

# Optional Anthropic fallback (sk-ant-...): Auto-fallback if OpenAI is down
ANTHROPIC_API_KEY=

# ── SQLite Database ───────────────────────────────────────────────────────
# Default: in-memory for tests, or ./data/forensics.db for local dev
DB_PATH=./data/forensics.db

# ── Port ─────────────────────────────────────────────────────────────────
PORT=3000
